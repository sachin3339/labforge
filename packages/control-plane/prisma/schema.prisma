// Prisma schema for LabForge control plane.
// Run: pnpm prisma:migrate -- --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  apiKey    String   @unique
  /// HMAC secret for outbound webhooks to this tenant's LMS.
  webhookSecret String @default(cuid())
  /// "platform" tenants can manage other tenants via /api/v1/platform/*.
  /// "tenant" (default) tenants can only manage their own resources.
  role          String   @default("tenant")
  /// Optional: pin every lab launched by this tenant to a specific node.
  /// Overrides template default; further overridden by an explicit
  /// admin-set instance.nodeId. Null = no tenant-level pin.
  defaultNodeId String?
  defaultNode   Node?    @relation("TenantDefaultNode", fields: [defaultNodeId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates LabTemplate[]
  instances LabInstance[]
  launches  Launch[]
  usageEvents UsageEvent[]
}

model LabTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  /// Validated against LabTemplateSpec (zod) at write time.
  spec        Json
  /// Optional: pin labs of this template to a specific node. Resolution
  /// order at provision time: instance.nodeId (explicit) > tenant.defaultNodeId
  /// > template.allowedNodeIds (round-robin within) > template.defaultNodeId
  /// > Node.isDefault. Null = follow tenant/default.
  defaultNodeId String?
  defaultNode   Node?  @relation("TemplateDefaultNode", fields: [defaultNodeId], references: [id], onDelete: SetNull)
  /// Round-robin pool. Empty array = "any enabled node" (legacy behaviour).
  /// Non-empty = scheduler only considers these nodes for new instances of
  /// this template, in round-robin order. Lets us bind heavyweight templates
  /// (Windows VMs, GPU labs) to dedicated hosts without taking the rest of
  /// the fleet out of rotation.
  allowedNodeIds String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instances LabInstance[]
  launches  Launch[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Launch {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId    String
  template      LabTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  userIdHash    String
  userDisplayName String?
  durationMinutes Int
  returnUrl     String?
  webhookUrl    String?
  context       Json?

  /// JTI of the launch token; null once redeemed (single-use).
  tokenJti      String?  @unique
  redeemedAt    DateTime?
  instanceId    String?  @unique
  instance      LabInstance? @relation(fields: [instanceId], references: [id])

  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([tenantId, createdAt])
}

enum InstanceStatus {
  pending
  provisioning
  ready
  idle
  paused
  terminating
  terminated
  failed
}

model LabInstance {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId  String
  template    LabTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  /// Physical host running this container. Null only on legacy rows from
  /// before the multi-node migration; new rows always have it set.
  nodeId      String?
  node        Node?    @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  status      InstanceStatus @default(pending)
  /// True while this instance is sitting in the warm pool unassigned.
  isPrewarm   Boolean  @default(false)

  /// Runtime-specific handle (docker container id, k8s pod name, ...).
  runtimeId   String?
  /// Host port the gateway forwards to on `node.proxyHost`. Stored so the
  /// proxy can reconstruct the upstream after a control-plane restart.
  hostPort    Int?
  /// Host:port the gateway routes to (e.g. "10.0.0.5:32145"). Composed
  /// from `node.proxyHost` + `hostPort` at provision time.
  upstream    String?
  /// Public subdomain segment used for {sub}.lab.example.com.
  subdomain   String   @unique

  userIdHash  String?
  lastSeenAt  DateTime?
  /// Last time the student actually interacted (HTTP request via proxy).
  /// Drives idle→suspend decisions independently of lastSeenAt (which
  /// captures any heartbeat including internal pings).
  lastActivityAt DateTime?
  /// Named Docker volume holding the student's persisted data. Same volume
  /// is re-mounted every time this (userIdHash, templateId) is re-provisioned.
  volumeName  String?
  /// Worker-host directory holding this instance's qcow2 overlay
  /// (`<dir>/data.qcow2`), bind-mounted into the container at `/storage`.
  /// Set only when the template's spec has `vmGoldenImage`. Used by
  /// destroy() to clean the overlay up; null on legacy / non-VM rows.
  vmOverlayPath String?
  /// Ephemeral host port the worker node assigned to the container's
  /// RDP port. Captured at provision time so the Guacamole gateway
  /// knows where to dial when the student redeems their lab. Null on
  /// non-VM / non-Guacamole instances.
  rdpHostPort Int?
  /// Guacamole login username for this instance — random per-instance
  /// so a leaked URL/password only exposes ONE student's lab. Re-used
  /// across resume/redeem cycles for the lifetime of the row.
  guacamoleUser     String?
  /// Guacamole login password (random, ~24 char). Used to log in to
  /// the gateway; not the Windows RDP password (which is in the
  /// template spec). Reset only when the row is destroyed.
  guacamolePassword String?
  /// When the lab was last suspended (docker stop). Null while active.
  suspendedAt DateTime?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  terminatedAt DateTime?

  launch      Launch?
  gradingResults GradingResult[]

  @@index([tenantId, status])
  @@index([templateId, status, isPrewarm])
  @@index([templateId, userIdHash, status])
}

model GradingResult {
  id          String   @id @default(cuid())
  tenantId    String
  instanceId  String
  instance    LabInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  launchId    String?
  templateId  String

  score       Float
  maxScore    Float
  passed      Boolean
  /// Per-check details: id, passed, exitCode, stdout, stderr, durationMs, error?
  checks      Json
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([instanceId, createdAt])
  @@index([launchId])
}

// Billing-grade audit log. Every interesting lab lifecycle moment writes
// a row here so we can derive pax-days, compute-hours, and dispute-
// resolution trails without scraping the LabInstance/Launch tables.
// Best-effort emit -- writes never block the user-visible path.
enum UsageEventKind {
  launch_created
  launch_redeemed
  instance_ready
  instance_idle
  instance_paused
  instance_resumed
  instance_terminated
}

model UsageEvent {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind        UsageEventKind
  /// Optional pointers (no FKs to allow event survival after cascade deletes).
  launchId    String?
  instanceId  String?
  templateId  String?
  userIdHash  String?
  /// Free-form billing context: durationMinutes, hours, reason, etc.
  payload     Json?
  occurredAt  DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([tenantId, kind, occurredAt])
  @@index([instanceId])
}

/// A physical host capable of running lab containers. Multi-node deploys
/// have one row per Docker host; single-node deploys keep a single row
/// named "local" pointing at the control-plane's own /var/run/docker.sock.
model Node {
  id              String   @id @default(cuid())
  /// Human-readable label shown in the admin UI (e.g. "local", "box-2").
  name            String   @unique
  /// One node is flagged default; provisions land here if nothing else pins.
  isDefault       Boolean  @default(false)
  /// 'local' uses /var/run/docker.sock on the control-plane host;
  /// 'ssh' tunnels dockerode through SSH to a remote box's docker.sock.
  connectionMode  String   @default("local")
  /// SSH host (required when connectionMode = 'ssh').
  sshHost         String?
  sshUser         String?  @default("ubuntu")
  sshPort         Int?     @default(22)
  /// Absolute path on the control-plane host to the SSH private key used
  /// to authenticate to this node (PEM, no passphrase).
  sshKeyPath      String?
  /// Plaintext SSH password — used when the node only allows password
  /// auth (e.g. a managed VM where you can't drop a key into authorized_keys).
  /// Treat as a secret: never returned by the platform API, never logged.
  /// Provide either `sshKeyPath` OR `sshPassword`; if both are present,
  /// the private key wins (more secure).
  sshPassword     String?
  /// Where the wildcard proxy reaches this node's published container
  /// ports (IP or hostname). Typically a private/Tailscale address so we
  /// don't expose containers on the public internet.
  proxyHost       String   @default("127.0.0.1")
  /// Which interface published container ports bind to on this node.
  /// Mirrors the host-side address of `proxyHost`; usually the same.
  bindIp          String   @default("0.0.0.0")
  /// Soft cap surfaced in the admin UI (instances). 0 = unlimited.
  capacityMax     Int      @default(0)
  /// Drained nodes accept no new provisions but keep existing instances.
  enabled         Boolean  @default(true)
  notes           String?
  /// Last successful ping (docker.version()) by the health poller.
  /// null = never reachable since boot. Scheduler treats nodes with a
  /// recent lastSeenAt (or null, to allow bootstrap) as eligible.
  lastSeenAt      DateTime?
  /// Last error message observed by the health poller. Cleared on a
  /// successful ping. Surfaced in the admin UI for quick triage.
  lastError       String?
  /// Docker engine version string from the last successful ping.
  dockerVersion   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  instances           LabInstance[]
  templateDefaults    LabTemplate[] @relation("TemplateDefaultNode")
  tenantDefaults      Tenant[]      @relation("TenantDefaultNode")

  @@index([enabled, isDefault])
}

/// Environment-wide Apache Guacamole gateway config. At most one row
/// (id = 'singleton'). Used by the redeem flow when a template's spec
/// has `viewer: 'guacamole-rdp'`: the control-plane creates a per-lab
/// connection in Guacamole (file-based user-mapping in v1, REST API
/// later), then redirects the student to a tokenised client URL on
/// `publicUrl`.
model GuacamoleConfig {
  id           String   @id @default("singleton")
  /// Public origin where students reach Guacamole, e.g.
  /// "https://rdp.labforge.example.com". No trailing slash.
  publicUrl    String
  /// Path on the Guacamole host to user-mapping.xml when using
  /// file-based auth. The control-plane (re)writes this file on every
  /// connection lifecycle change. Guacamole reads it fresh on every
  /// login, so no service reload is needed. e.g.
  /// "/opt/guacamole/user-mapping.xml".
  userMappingPath String?
  /// When set, the control-plane writes user-mapping.xml on this remote
  /// host via SSH (separate from the worker-node SSH config — the
  /// Guacamole host is usually the primary, not a worker). Leave null
  /// to write to the local filesystem (Guacamole running in Docker on
  /// the same machine as the control-plane, with the file bind-mounted).
  sshHost      String?
  sshUser      String?  @default("ubuntu")
  sshPort      Int?     @default(22)
  sshKeyPath   String?
  sshPassword  String?
  /// Host (IP/DNS) the GUACAMOLE container uses to reach the worker
  /// node's published RDP host port. For a same-machine deploy this
  /// is "host.docker.internal" or the host's private IP; for cross-
  /// host it's the worker's public/private IP. Per-instance lookup
  /// uses `Node.proxyHost` first and falls back here when empty.
  defaultRdpHost String?
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
