# Root .env template — used by docker-compose.yml (local dev with `pnpm stack:up`).
# Copy to .env and fill values:
#   Copy-Item .env.example .env
#   node scripts/gen-keys.mjs | Add-Content .env
#
# NEVER commit the real .env — it's gitignored.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

DATABASE_URL=postgresql://labforge:labforge@localhost:5432/labforge?schema=public
REDIS_URL=redis://localhost:6379

JWT_ISSUER=labforge-dev
JWT_LAUNCH_TTL_SECONDS=60
JWT_SESSION_TTL_SECONDS=14400

# Generated by `node scripts/gen-keys.mjs` — paste output here
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

PUBLIC_API_URL=http://lab.localhost:4000
PUBLIC_LAB_DOMAIN=lab.localhost
PUBLIC_GATEWAY_URL=http://lab.localhost:4000

RUNTIME=docker
DOCKER_HOST_SOCKET=//./pipe/docker_engine
DOCKER_NETWORK=labforge_labnet

LAB_DEFAULT_CPU=1
LAB_DEFAULT_MEMORY_MB=1024
LAB_IDLE_TIMEOUT_MINUTES=10
LAB_MAX_DURATION_MINUTES=240

PREWARM_ENABLED=true
PREWARM_INTERVAL_SECONDS=15

SEED_TENANT_NAME=Demo Trainers
SEED_TENANT_API_KEY=dev-api-key-change-me
