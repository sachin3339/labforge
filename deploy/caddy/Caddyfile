# LabForge production Caddyfile.
# Wildcard TLS via Cloudflare DNS-01. CLOUDFLARE_API_TOKEN must be exported
# in the Caddy container env (see docker-compose.prod.yml).
#
# Routes:
#   admin.environments.learnlytica.com → admin-ui:4100
#   api.environments.learnlytica.com   → control-plane:4000
#   *.lab.environments.learnlytica.com → control-plane:4000 (wildcard subdomain
#       proxy inside the control plane forwards to the right lab container)

{
    email ops@learnlytica.com
}

# ---- admin UI ----
admin.environments.learnlytica.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
    encode gzip
    reverse_proxy admin-ui:4100
}

# ---- control plane API ----
api.environments.learnlytica.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
    encode gzip
    reverse_proxy control-plane:4000
}

# ---- wildcard for live lab subdomains ----
*.lab.environments.learnlytica.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }

    # Guacamole HTML5 RDP client is served per-VM on the VM's OWN lab
    # subdomain so every VM gets an isolated browser origin. Browsers
    # partition localStorage by origin, so the GUAC_AUTH / GUAC_HISTORY /
    # GUAC_PREFERENCES keys no longer collide across tabs when a student
    # opens several VMs at once. These requests (including the
    # /guacamole/websocket-tunnel framebuffer) go straight to the shared
    # guacamole container — one wildcard, no per-VM DNS/cert/route — and
    # bypass the control-plane lf_session cookie (Guacamole authenticates
    # via its own username/password query-auth).
    @guac path /guacamole /guacamole/*
    handle @guac {
        reverse_proxy guacamole:8080 {
            flush_interval -1
        }
    }

    # Everything else → control-plane wildcard proxy (noVNC / Kasm labs).
    # WebSocket upgrades flow through unchanged.
    handle {
        reverse_proxy control-plane:4000 {
            flush_interval -1
        }
    }
}

# ---- Guacamole RDP gateway (HTML5 RDP client) ----
# DNS prerequisite (Cloudflare, grey-cloud / proxied=OFF):
#   A   rdp.environments         148.113.1.66
# The redeem flow auto-logs the student in via ?username=&password=
# query-auth and lands them on a single connection wired to their lab.
rdp.environments.learnlytica.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
    # Guacamole speaks WebSocket for the framebuffer; flush_interval -1
    # disables Caddy's response buffering so frames stream live.
    reverse_proxy guacamole:8080 {
        flush_interval -1
    }
}
