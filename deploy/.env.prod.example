# ===== LabForge production env =====
# Copy to deploy/.env.prod and fill in.

# --- Postgres ---
# Generate a strong one: openssl rand -hex 16
POSTGRES_PASSWORD=

# --- Cloudflare DNS-01 (wildcard TLS) ---
# Token with Zone:DNS:Edit on learnlytica.com.
# Cloudflare → My Profile → API Tokens → Create Token → "Edit zone DNS".
CLOUDFLARE_API_TOKEN=

# --- JWT keys (RS256) ---
# Generate with: node scripts/gen-keys.mjs
# Paste the base64 values from its output here.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ISSUER=labforge

# --- Seed tenant ---
# This becomes the admin login API key. Make it long + random:
#   openssl rand -hex 32
SEED_TENANT_NAME=Learnlytica
SEED_TENANT_API_KEY=
